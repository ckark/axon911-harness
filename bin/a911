#!/usr/bin/env bash
# Launch Claude Code across the four Axon 911 workspace roots.
#
# Claude Code has no multi-root workspace concept, and the distinction matters:
# --add-dir loads each added directory's .claude/skills and .claude/commands,
# whereas permissions.additionalDirectories grants file access and loads
# nothing. So this is what makes axon911-frontend's 30 skills and prepared911's
# 73 available in one session.
#
# axon911-frontend is listed first: it owns @prepared/ui-* post CORE-754.
set -euo pipefail

AXON911_ROOT="${AXON911_ROOT:-/Users/ckark/Documents/GitHub/axon911-frontend}"
PREPARED911_ROOT="${PREPARED911_ROOT:-/Users/ckark/Documents/GitHub/prepared911}"
VAULT_ROOT="${VAULT_ROOT:-/Users/ckark/Documents/GitHub/vault-core-ux}"

args=()
for root in "$AXON911_ROOT" "$PREPARED911_ROOT" "$VAULT_ROOT"; do
  if [ -d "$root" ]; then
    args+=(--add-dir "$root")
  else
    printf 'a911: skipping missing root %s\n' "$root" >&2
  fi
done

# Warn early rather than letting the tier gate report `unmeasurable` later.
if [ -d "$AXON911_ROOT" ] && \
   [ "$(git -C "$AXON911_ROOT" rev-parse --is-shallow-repository 2>/dev/null)" = "true" ]; then
  printf 'a911: %s is a shallow clone; tier scoring will report unmeasurable.\n' "$AXON911_ROOT" >&2
  printf 'a911: fix with: git -C %s fetch --unshallow\n' "$AXON911_ROOT" >&2
fi

exec claude "${args[@]}" "$@"
