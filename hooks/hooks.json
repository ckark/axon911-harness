{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py SessionStart",
            "statusMessage": "Loading Axon 911 workspace rule",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py PreToolUse",
            "statusMessage": "Checking mutation preflight",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py PostToolUse",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py SubagentStart",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py SubagentStop",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py PreCompact",
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py TaskCreated",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py TaskCompleted",
            "statusMessage": "Checking task evidence",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py Stop",
            "statusMessage": "Verifying evidence before finishing",
            "timeout": 20
          },
          {
            "type": "agent",
            "prompt": "You are the evidence verifier for the Axon 911 review harness. The deterministic gate returned INCONCLUSIVE, so decide whether this turn may end.\n\nHook input: $ARGUMENTS\n\nRun `python3 \"${CLAUDE_PLUGIN_ROOT}\"/harness/cli.py tier --json` and `git status --short` plus `git diff --stat` in the working root. Then check, in order:\n\n1. Does the diff implement what the turn claimed to do? Claimed-but-absent work is a deny.\n2. Is anything in the diff outside the declared plan scope, unexplained? Undeclared scope creep is a deny.\n3. For a user-visible change in packages/ui-*, is there rendered evidence (a story, or a captured screenshot under .harness/runtime/evidence)? Remember `pnpm check` gives NO lint signal on packages/ui-* or apps/docs, so a green check is not evidence there.\n\nReturn ONLY JSON: {\"hookSpecificOutput\":{\"hookEventName\":\"Stop\",\"permissionDecision\":\"allow\"|\"deny\",\"permissionDecisionReason\":\"<one specific sentence naming the missing evidence>\"}}\n\nAllow when the work is genuinely complete and evidenced. Do not deny for style preferences, and do not deny twice for the same reason.",
            "model": "sonnet",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
