<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.ng911.axon911-harness.evals-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HARNESS__/harness/cli.py</string>
    <string>evals</string>
    <string>daily</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>__HARNESS__</string>
  <key>StandardOutPath</key>
  <string>__HARNESS__/.harness/runtime/evals/daily.log</string>
  <key>StandardErrorPath</key>
  <string>__HARNESS__/.harness/runtime/evals/daily.err</string>
</dict>
</plist>
