<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.ng911.axon911-harness.evals-routing-smoke</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HARNESS__/harness/cli.py</string>
    <string>evals</string>
    <string>run</string>
    <string>routing</string>
    <string>--sample</string>
    <string>10</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>__HARNESS__</string>
  <key>StandardOutPath</key>
  <string>__HARNESS__/.harness/runtime/evals/routing-smoke.log</string>
  <key>StandardErrorPath</key>
  <string>__HARNESS__/.harness/runtime/evals/routing-smoke.err</string>
</dict>
</plist>
